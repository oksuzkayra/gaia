# ============================================================
# GAIA LLM CONFIG (LiteLLM)
# ============================================================

# The model name Gaia will pass to LiteLLM.
# For Ollama: use ollama/<model_name>
# Example: ollama/gpt-oss:20b  or  ollama/qwen2.5:14b
GAIA_LLM_MODEL=ollama/gpt-oss:20b

# Optional fallback names (Gaia resolves GAIA_LLM_MODEL first)
OPENAI_MODEL=
LLM_MODEL=
GAIA_LLM_DEBUG=false


# ============================================================
# PROVIDER ENV VARIABLES (LiteLLM decides based on these)
# You only fill what you need.
# ============================================================

# ----- OLLAMA LOCAL INFERENCE -----
# Default Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# If you want a custom model name for Ollama (optional)
# OLLAMA_MODEL=gpt-oss:20b


# ----- OPENAI / OPENAI-COMPATIBLE -----
# OPENAI_API_KEY=
# OPENAI_BASE_URL=  # e.g. https://api.openai.com/v1


# ----- ANTHROPIC (Claude) -----
# ANTHROPIC_API_KEY=


# ----- GOOGLE GEMINI -----
# GEMINI_API_KEY=


# ============================================================
# GAIA SCANNING FLAGS (optional)
# ============================================================

# Disable or enable optional external tools
GAIA_DISABLE_GAU=false
GAIA_DISABLE_ARJUN=false
GAIA_DISABLE_LINKFINDER=false
GAIA_DISABLE_URO=false

# Maximum endpoints after uro normalization (optional)
GAIA_URO_MAX=10000
